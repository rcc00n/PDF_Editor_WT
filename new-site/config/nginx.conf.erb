daemon off;
worker_processes 1;

events { worker_connections 1024; }

http {
  include /app/config/mime.types;
  sendfile on;
  access_log /dev/stdout;
  error_log /dev/stderr;

  server {
    listen <%= ENV["PORT"] %>;
    root /app;
    index index.html;

    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
